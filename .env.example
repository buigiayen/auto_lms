# Copy this file to `.env` and adjust values as needed.
# IMPORTANT: `.env` contains secrets — do NOT commit it.

# ---- Worker mode: ReadOnlyProbe (safe) | AutoStudy (real writes) | Idle ----
WORKER_MODE=AutoStudy

# ---- Account (required) ----
LOTUSLMS_USERNAME=your_lotuslms_username
LOTUSLMS_PASSWORD=your_lotuslms_password

# ---- Request context (matches the web client) ----
LOTUSLMS_CLIENT_SYNC_TOKEN=your_client_sync_token
LOTUSLMS_REQUEST_ID=your_request_id
LOTUSLMS_REQUEST_TOKEN=your_request_token
LOTUSLMS_STUDENT_REQUEST_ID=your_student_request_id
LOTUSLMS_STUDENT_REQUEST_TOKEN=your_student_request_token

# ---- Fixed device/session identity (avoids token_invalid on long runs) ----
LOTUSLMS_DEVICE_UUID=your_device_uuid
LOTUSLMS_SESSION_ID=your_session_id

# ---- API response logs (contain sensitive account/session data) ----
LOG_API_RESPONSES=true
API_RESPONSE_LOG_DIRECTORY=logs/api-responses

# ---- Proxy (disabled by default; this proxy is currently unreachable from macOS) ----
PROXY_ENABLED=false
PROXY_ADDRESS=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_DOMAIN=
PROXY_BYPASS_ON_LOCAL=true
PROXY_USE_DEFAULT_CREDENTIALS=false

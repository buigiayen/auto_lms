# Copy to .env, then generate and set a private key:
# openssl rand -hex 32
# Use the same key for Client and LotusLMS.Worker.V2.
WORKER_REGISTRATION_KEY=replace-with-output-from-openssl-rand-hex-32

# Client web UI
CLIENT_PORT=3100
CLIENT_USERNAME=admin
CLIENT_PASSWORD=
# Set true when accessing the UI through HTTPS.
CLIENT_SESSION_SECURE=false

# LotusLMS.Worker.V2
# Set the actual server hostname here when running in Docker; empty uses the container hostname.
SERVER_NAME=
WORKER_NAME=worker-v2
MAX_CONCURRENT_ACCOUNTS=5
CLIENT_REQUEST_TIMEOUT_SECONDS=10
POLL_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=5
STOP_ON_DAILY_KPI=false
INCLUDE_PRACTICE=false
WORK_REST_ENABLED=true
CONTINUOUS_WORK_MINUTES=180
MIN_REST_MINUTES=15
MAX_REST_MINUTES=30

# Optional Discord alerts. Separate webhook URLs with ; (keep real URLs private).
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URLS=
# Add ,account_failed to receive account/LMS errors as well.
DISCORD_EVENTS=worker_failed,lane_failed

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "LotusLms": {
    "LogApiResponses": false
  },
  "Discord": {
    "Enabled": false,
    "WebhookUrls": "",
    "Events": "worker_failed,lane_failed",
    "RequestTimeoutSeconds": 5,
    "DeliveryTimeoutSeconds": 15,
    "MaxRetries": 2
  },
  "Worker": {
    "WorkerName": "worker-v2",
    "MaxConcurrentAccounts": 5,
    "PollIntervalSeconds": 5,
    "HeartbeatIntervalSeconds": 5,
    "StatusIntervalSeconds": 60,
    "WorkRestEnabled": true,
    "ContinuousWorkMinutes": 180,
    "MinRestMinutes": 15,
    "MaxRestMinutes": 30,
    "SaveItemSeconds": 15,
    "TrackTimeSeconds": 15,
    "KpiCheckEverySaves": 3,
    "StopOnDailyKpi": false,
    "IncludePractice": false,
    "PracticeBatchSize": 5,
    "PracticeIntervalSeconds": 5,
    "PracticeMaxIntervalSeconds": 10,
    "MarkPracticeFinished": false,
    "OnlyFirstPlan": true,
    "OnlyFirstCoursePage": true
  },
  "Client": {
    "BaseUrl": "http://127.0.0.1:3100",
    "RequestTimeoutSeconds": 5
  }
}

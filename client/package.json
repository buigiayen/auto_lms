{
  "name": "lotuslms-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server/index.js",
    "dev": "node --env-file-if-exists=../.env --watch src/server/dev.js",
    "test": "node --test tests/*.test.js",
    "test:worker": "node tests/worker-smoke.mjs",
    "test:worker-v2": "node tests/worker-v2-smoke.mjs",
    "test:worker-v2-isolation": "node tests/worker-v2-isolation.mjs",
    "test:worker-v2-rest": "node tests/worker-v2-rest-smoke.mjs",
    "check": "node scripts/check.js"
  },
  "dependencies": { "undici": "8.12.3" }
}

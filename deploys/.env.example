# GHCR image and deployment
IMAGE_PREFIX=ghcr.io/buigiayen/auto_lms
IMAGE_TAG=latest
REPLICAS=1
CLIENT_BIND_ADDRESS=127.0.0.1
CLIENT_PORT=3100
CLIENT_ALLOWED_HOSTS=
CLIENT_DATA_VOLUME=lotuslms-client-data

# Generate a private bootstrap key: openssl rand -hex 32
WORKER_REGISTRATION_KEY=
CLIENT_USERNAME=admin
CLIENT_PASSWORD=
CLIENT_SESSION_SECURE=false

# Worker
SERVER_NAME=
WORKER_NAME=worker-v2
MAX_CONCURRENT_ACCOUNTS=5
CLIENT_REQUEST_TIMEOUT_SECONDS=10
POLL_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=5
STOP_ON_DAILY_KPI=true
INCLUDE_PRACTICE=false
WORK_REST_ENABLED=true
CONTINUOUS_WORK_MINUTES=180
MIN_REST_MINUTES=15
MAX_REST_MINUTES=30

# Discord: separate webhook URLs with ;. Never commit real URLs/tokens.
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URLS=
# Add ,account_failed to receive account/LMS errors as well.
DISCORD_EVENTS=worker_failed,lane_failed

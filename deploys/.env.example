# Images published by .github/workflows/publish-images.yml.
IMAGE_PREFIX=ghcr.io/buigiayen/auto_lms
# latest tracks the default branch. Use a shared sha-<full commit SHA> tag to pin both services.
IMAGE_TAG=latest

# Required: generate with openssl rand -hex 32 and paste the result here.
# Client and worker use this same value.
WORKER_REGISTRATION_KEY=

# Required: admin login checked by the backend, never sent to the browser.
CLIENT_USERNAME=admin
CLIENT_PASSWORD=
# true for HTTPS; false for localhost/SSH tunnel/plain HTTP on a private network.
CLIENT_SESSION_SECURE=false

# Client UI: localhost by default; use an SSH tunnel or a reverse proxy.
CLIENT_BIND_ADDRESS=127.0.0.1
CLIENT_PORT=3100
# Extra accepted request hostnames/IPs, comma-separated, without scheme or port.
# Example: lms.example.com,203.0.113.10
CLIENT_ALLOWED_HOSTS=

# Persistent database, encryption key and worker API keys.
CLIENT_DATA_VOLUME=lotuslms-client-data

# Worker V2. Give each independent worker deployment a distinct name.
WORKER_NAME=worker-v2
MAX_CONCURRENT_ACCOUNTS=5
CLIENT_REQUEST_TIMEOUT_SECONDS=10
POLL_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=5
# Daily KPI -> resume at a random time in 00:00–08:00 the following Vietnam day.
STOP_ON_DAILY_KPI=true
INCLUDE_PRACTICE=false
